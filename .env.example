# Never commit real keys. Put them in sportsodds runtime secrets or GitHub environment secrets.
BALLDONTLIE_API_KEY=
THE_ODDS_API_KEY=

# Data-provider configuration
BALLDONTLIE_BASE_URL=https://api.balldontlie.io
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com
THE_ODDS_API_SPORT_KEY=basketball_wnba
ODDS_REGIONS=us
ODDS_BOOKMAKERS=
ODDS_MARKETS=player_points,player_rebounds,player_assists,player_threes,player_points_rebounds_assists,h2h,spreads,totals

# Runtime
ENVIRONMENT=development
DATA_DIR=/data
DATABASE_URL=postgresql://wizard:change-me@postgres:5432/wizard_wnba
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080

# Live polling
LIVE_ENABLED=false
GAME_DISCOVERY_SECONDS=30
PLAY_POLL_SECONDS=1.5
STATE_POLL_SECONDS=2.5
PROP_POLL_SECONDS=4.0
ESPN_RECONCILE_SECONDS=8.0
MAX_GAME_STATE_AGE_SECONDS=4.0
MAX_MARKET_AGE_SECONDS=12.0

# Recommendation policy: D (adaptive), with hard minimum conservative ROI 2%
POLICY_MODE=adaptive
HARD_MIN_CONSERVATIVE_ROI=0.02
BASE_CONSERVATIVE_ROI=0.02
MIN_BOOK_COUNT=2
MAX_TOTAL_UNCERTAINTY=0.08
MIN_CALIBRATION_SCORE=0.75
PUBLICATION_TTL_SECONDS=20

# Simulation
DEFAULT_SIMULATIONS=20000
HIGH_LIABILITY_SIMULATIONS=50000
RANDOM_SEED=20260714
